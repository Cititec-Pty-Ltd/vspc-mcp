# Veeam Service Provider Console (VSPC 9.1, REST API v3).
# The console's address, https only, with its port (no path): for example
# https://vspc.example.local:1280
VSPC_URL=

# A Simple REST API key (VSPC: Configuration > Access Management > REST API
# Keys; scope rest; tick "read only" unless the write tools are needed). It is
# sent as "Authorization: Bearer <key>" and is never logged or returned.
VSPC_API_KEY=

# true only when the console's certificate is self-signed or not issued for
# the name in VSPC_URL. The connection is still encrypted, but the server is
# not authenticated: use it only on a trusted network path (VPN).
VSPC_ACCEPT_SELF_SIGNED=false

# Log level (stderr): debug, info, warn, error. Tool arguments and the key are
# never logged.
LOG_LEVEL=info
